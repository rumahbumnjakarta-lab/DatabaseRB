{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-attendance",
      "schedule": "0 20 * * *"
    }
  ]
}
